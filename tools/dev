#!/usr/bin/env bash
# shellcheck disable=SC2155,SC2164,SC2001

devhelp() {
    echo ""
    echo -e "======================================="
    echo -e "\033[1;34mdeap-er Devtools - Command Line Interface\033[0m"
    echo -e "Management of the deap-er local development environment."
    echo ""
    echo -e "\033[1mUsage:\033[0m"
    echo -e "  source tools/dev"
    echo ""
    echo -e "\033[1mFunctions:\033[0m"
    echo -e "  \033[32magent\033[0m       Activate interactive Cursor CLI in current terminal session"
    echo -e "  \033[32mpycov\033[0m       Open the latest Python coverage report in the browser"
    echo -e "  \033[32mallure\033[0m      Open the latest Allure report for the current directory"
    echo -e "  \033[32mcodegraph\033[0m   Open the codebase-memory-mcp graph visualization"
    echo -e "  \033[32mexitdev\033[0m     Deactivate the Python virtual environment and remove the prompt prefix"
    echo -e "  \033[32mdevhelp\033[0m     Show this help message"
    echo ""
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
    devhelp
    exit 1
fi

if command -v git >/dev/null 2>&1 && git rev-parse --show-toplevel >/dev/null 2>&1; then
    export PROJECT_DIR="$(git rev-parse --show-toplevel)"
else
    export PROJECT_DIR="$(cd -- "$(dirname "${BASH_SOURCE[0]}")/.." >/dev/null 2>&1 && pwd)"
fi
export BINARIES_DIR="${PROJECT_DIR}/.bin"
export TOOLS_DIR="${PROJECT_DIR}/tools"
export VIRTUAL_ENV_DISABLE_PROMPT=1
export UV_COMPILE_BYTECODE=1
export PATH="$PROJECT_DIR:$PATH"
export PATH="$BINARIES_DIR:$PATH"
export PATH="$HOME/.bun/bin:$PATH"
export PATH="$HOME/.local/bin:$PATH"

if [[ "$1" == "only_export_environs" ]]; then
    return 0
fi

SCRIPTS="${TOOLS_DIR}/dev_scripts"
source "${SCRIPTS}/01_define_cli_functions.sh"
source "${SCRIPTS}/02_ensure_git_config.sh"
source "${SCRIPTS}/03_install_cli_tools.sh"
source "${SCRIPTS}/04_install_python_deps.sh"
source "${SCRIPTS}/05_install_node_deps.sh"
source "${SCRIPTS}/06_enable_autosource.sh"

source .venv/bin/activate
_deap_er_enable_prompt

devhelp
