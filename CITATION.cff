    title: "DEAP: Evolutionary Algorithms Made Easy"
    authors:
      - family-names: Fortin
        given-names: Félix-Antoine
      - family-names: De Rainville
        given-names: François-Michel
      - family-names: Gardner
        given-names: Marc-André
      - family-names: Parizeau
        given-names: Marc
      - family-names: Gagné
        given-names: Christian
    journal: Journal of Machine Learning Research
    volume: "13"
    issue: "70"
    year: 2012
    month: 7
    start: 2171
    end: 2175
    url: https://www.jmlr.org/papers/v13/fortin12a.html
    notes: >-
      Please cite this paper when publishing results produced
      with deap-er or DEAP.
